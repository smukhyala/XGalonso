# ---------------------------------------------------------------------------
# Data and artifacts — never committed. Raw data is immutable and lives outside
# git; see docs/architecture/01_repository_structure.md.
# ---------------------------------------------------------------------------
# Both forms: a trailing slash matches only a directory, so a `.data` symlink
# pointing at the real store — which is a convenient way to share one dataset
# between worktrees — slipped past the ignore and got committed once.
.data
.data/
.data/bronze/
.data/silver/
.data/gold/
.artifacts/
.artifacts/models/
.artifacts/features/
*.duckdb
*.duckdb.wal

# Parquet anywhere except committed test fixtures
*.parquet
!data/fixtures/**/*.parquet
!tests/**/fixtures/**/*.parquet

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Notebooks — outputs are noise in review
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# Web front end (apps/web)
node_modules/
.next/
# Incremental TypeScript build cache. Machine-local, regenerated on every build.
*.tsbuildinfo
next-env.d.ts
