[importlinter]
root_packages =
    xg_alonso
include_external_packages = True

# ---------------------------------------------------------------------------
# The dependency direction from docs/architecture/01_repository_structure.md.
# Modules on the same line are siblings and may not import each other.
# ---------------------------------------------------------------------------

[importlinter:contract:layers]
name = Package dependency direction
type = layers
layers =
    xg_alonso.api
    xg_alonso.cli : xg_alonso.pipelines
    xg_alonso.discovery
    xg_alonso.evaluation
    xg_alonso.optimization : xg_alonso.explanations
    xg_alonso.prediction
    xg_alonso.features
    xg_alonso.interpreter
    xg_alonso.domain : xg_alonso.storage
    xg_alonso.contracts

# ---------------------------------------------------------------------------
# The storage adapter is the only place a database driver may appear. Without
# this gate, four packages independently reached for duckdb during planning.
# ---------------------------------------------------------------------------

[importlinter:contract:duckdb-isolation]
name = duckdb is importable only from the storage adapter
type = forbidden
source_modules =
    xg_alonso.contracts
    xg_alonso.domain
    xg_alonso.interpreter
    xg_alonso.features
    xg_alonso.prediction
    xg_alonso.optimization
    xg_alonso.explanations
    xg_alonso.evaluation
    xg_alonso.cli
    xg_alonso.api
    xg_alonso.pipelines
    xg_alonso.discovery
forbidden_modules =
    duckdb

# ---------------------------------------------------------------------------
# domain holds pure football and FPL rules. It must stay free of I/O so it can
# be tested without a database, a network, or a dataframe engine.
# ---------------------------------------------------------------------------

[importlinter:contract:domain-purity]
name = domain is pure — no I/O, no dataframe engine, no HTTP
type = forbidden
source_modules =
    xg_alonso.domain
forbidden_modules =
    duckdb
    polars
    httpx
    pyarrow
    sqlite3

# ---------------------------------------------------------------------------
# contracts is the shared vocabulary. It must depend on nothing internal, or it
# stops being a boundary and becomes a second implementation.
#
# polars IS permitted here: the storage protocols are typed in terms of frames,
# and a dataframe type is legitimate shared vocabulary for an analytics system.
# A database driver and an HTTP client are not — those are implementation
# choices that belong behind an adapter, so they stay forbidden.
# ---------------------------------------------------------------------------

[importlinter:contract:contracts-independence]
name = contracts depends on no other internal package
type = forbidden
source_modules =
    xg_alonso.contracts
forbidden_modules =
    xg_alonso.domain
    xg_alonso.storage
    xg_alonso.features
    xg_alonso.prediction
    xg_alonso.optimization
    xg_alonso.explanations
    xg_alonso.pipelines
    xg_alonso.cli
    xg_alonso.discovery
    duckdb
    httpx

# ---------------------------------------------------------------------------
# HTTP belongs to ingestion. Nothing downstream may reach for the network,
# which is what keeps feature builds reproducible from stored snapshots.
# ---------------------------------------------------------------------------

[importlinter:contract:http-isolation]
name = httpx is importable only from ingestion
type = forbidden
source_modules =
    xg_alonso.contracts
    xg_alonso.domain
    xg_alonso.storage
    xg_alonso.features
    xg_alonso.prediction
    xg_alonso.optimization
    xg_alonso.explanations
forbidden_modules =
    httpx

# ---------------------------------------------------------------------------
# The discovery *core* is a generic feature-search engine that happens to be
# used for football. Keeping it that way is a claim, so it is checked rather
# than asserted in a docstring: these modules may speak the shared contracts
# vocabulary and nothing else about this domain.
#
# The FPL bindings live in xg_alonso.discovery.experiment, which is deliberately
# absent from the source list below and may import anything.
# ---------------------------------------------------------------------------

[importlinter:contract:discovery-core-is-generic]
name = the discovery core knows nothing about football
type = forbidden
source_modules =
    xg_alonso.discovery.dsl
    xg_alonso.discovery.compile
    xg_alonso.discovery.utility
    xg_alonso.discovery.acceptance
    xg_alonso.discovery.search
    xg_alonso.discovery.registry
forbidden_modules =
    xg_alonso.domain
    xg_alonso.features
    xg_alonso.prediction
    xg_alonso.optimization
    xg_alonso.evaluation

# ---------------------------------------------------------------------------
# The research surface is quarantined from the deterministic core.
#
# `discovery` proposes features and `interpreter` reads free text, both
# optionally through a language model and over the network. Neither may sit
# under a prediction, an optimization or an evaluation: a recommendation has to
# be reproducible from stored snapshots alone, and a core that imported either
# could stop being so without any test noticing.
#
# The layers contract already places `discovery` above the core, but it puts
# `interpreter` *below* `features` — so without this gate `prediction` could
# import the LLM client and nothing would object.
#
# Apps are deliberately absent from the source list. `cli` and `api` are where
# a research tool is wired up as a command or an endpoint, which is what an app
# layer is for. The claim being enforced is that the core does not depend on
# research, not that research is unreachable.
# ---------------------------------------------------------------------------

[importlinter:contract:research-surface-is-quarantined]
name = the deterministic core does not depend on discovery or the interpreter
type = forbidden
source_modules =
    xg_alonso.contracts
    xg_alonso.domain
    xg_alonso.storage
    xg_alonso.features
    xg_alonso.prediction
    xg_alonso.optimization
    xg_alonso.explanations
    xg_alonso.evaluation
    xg_alonso.pipelines
forbidden_modules =
    xg_alonso.discovery
    xg_alonso.interpreter
